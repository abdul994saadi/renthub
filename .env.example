# Copy to .env (or set these in your hosting dashboard).
PORT=3000
NODE_ENV=production
# Long random string used to sign shop login cookies.
SESSION_SECRET=change-me-to-a-long-random-string
# Currency shown on prices (ISO code, e.g. USD, AED, EUR, SAR).
CURRENCY=USD

# Public address of the site, used in Stripe return links (e.g. https://renthub.example.com).
APP_URL=

# Stripe (https://dashboard.stripe.com/apikeys). Use sk_test_... keys while testing.
# Leave empty in development to simulate payments on /dev/pay. Required in production.
STRIPE_SECRET_KEY=
# From the webhook endpoint you create for https://<your-site>/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Commission kept from bookings at shops that connected their own Stripe account (0-100).
PLATFORM_FEE_PERCENT=0

# Email (SMTP). Leave SMTP_HOST empty to save emails to /dev/outbox instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RentHub <bookings@yourdomain.com>"

# Where data is stored (point both at a persistent disk when hosting).
# DATABASE_FILE=/var/data/app.db
# UPLOAD_DIR=/var/data/uploads
