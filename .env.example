# Copy to .env (or set these in your hosting dashboard).
PORT=3000
NODE_ENV=production
# Long random string used to sign shop login cookies.
SESSION_SECRET=change-me-to-a-long-random-string
# Time zone of the rental shops (pick-up times), and the free-cancellation window in hours.
TIMEZONE=Asia/Beirut
FREE_CANCELLATION_HOURS=24
# Password for the site owner's email check page at /admin/email (username: admin).
ADMIN_PASSWORD=
# Currency shown on prices (ISO code, e.g. USD, AED, EUR, SAR).
CURRENCY=USD

# Public address of the site, used in payment return links (e.g. https://renthub.example.com).
APP_URL=

# "online" (Amazon Payment Services) or "pickup" (customers pay the shop at pick-up; no APS needed).
PAYMENT_MODE=online

# Amazon Payment Services (APS dashboard -> Integration Settings -> Security Settings).
# Leave empty in development to simulate payments on /dev/pay. Required in production when PAYMENT_MODE=online.
APS_MERCHANT_IDENTIFIER=
APS_ACCESS_CODE=
APS_SHA_REQUEST_PHRASE=
APS_SHA_RESPONSE_PHRASE=
# sha256 or sha512, matching the SHA type chosen in the APS dashboard.
APS_SHA_TYPE=sha256
# "sandbox" (test) or "production" (live payments).
APS_ENVIRONMENT=sandbox
# Commission RentHub keeps from each paid booking (0-100), shown to shops on their Payments tab.
PLATFORM_FEE_PERCENT=0

# Email (SMTP). Leave SMTP_HOST empty to save emails to /dev/outbox instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RentHub <bookings@yourdomain.com>"

# Where data is stored (point both at a persistent disk when hosting).
# DATABASE_FILE=/var/data/app.db
# UPLOAD_DIR=/var/data/uploads
