# Copy to .env (or set these in your hosting dashboard).
PORT=3000
NODE_ENV=production
# Long random string used to sign shop login cookies.
SESSION_SECRET=change-me-to-a-long-random-string
# Currency shown on prices (ISO code, e.g. USD, AED, EUR, SAR).
CURRENCY=USD

# Email (SMTP). Leave SMTP_HOST empty to save emails to /dev/outbox instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="RentHub <bookings@yourdomain.com>"
