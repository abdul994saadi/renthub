<%- include('partials/head', { title: 'Review your booking' }) %>
<div class="wrap narrow section">
  <h1>Review your booking</h1>
  <div class="card pad">
    <div class="review-car">
      <div class="thumb"><%- include('partials/car-image', { car }) %></div>
      <div>
        <h2 class="h3"><%= car.year %> <%= car.make %> <%= car.model %></h2>
        <p class="muted small"><%= car.transmission %> · <%= car.seats %> seats · <%= car.fuel %></p>
        <p class="small"><strong><%= shop.name %></strong><br><%= [shop.address, shop.city].filter(Boolean).join(', ') %></p>
      </div>
    </div>
    <table class="summary">
      <tr><td>Pick-up</td><td><%= formatDate(d.pickup) %></td></tr>
      <tr><td>Return</td><td><%= formatDate(d.ret) %></td></tr>
      <tr><td>Daily rate</td><td><%= money(q.dailyPrice) %> × <%= q.days %> day<%= q.days === 1 ? '' : 's' %></td></tr>
      <tr class="total"><td>Total</td><td><%= money(q.total) %></td></tr>
      <% if (car.deposit) { %><tr><td>Refundable deposit</td><td><%= money(car.deposit) %> <span class="muted small">at pick-up</span></td></tr><% } %>
    </table>
    <h2 class="h3">Your details</h2>
    <dl class="info">
      <dt>Name</dt><dd><%= d.name %></dd>
      <dt>Email</dt><dd><%= d.email %></dd>
      <dt>Phone</dt><dd><%= d.phone %></dd>
      <% if (d.notes) { %><dt>Notes</dt><dd><%= d.notes %></dd><% } %>
    </dl>
    <p class="muted small">You pay the shop when you collect the car. A confirmation email will be sent to <strong><%= d.email %></strong>.</p>

    <form method="post" action="/cars/<%= car.id %>/confirm" class="actions">
      <% for (const [k, v] of Object.entries({ pickup: d.pickup, return: d.ret, name: d.name, email: d.email, phone: d.phone, notes: d.notes, licence: 'yes' })) { %>
        <input type="hidden" name="<%= k %>" value="<%= v %>">
      <% } %>
      <a class="btn btn-ghost" href="/cars/<%= car.id %>?pickup=<%= d.pickup %>&return=<%= d.ret %>">Change</a>
      <button class="btn btn-big" type="submit">Confirm booking</button>
    </form>
  </div>
</div>
<%- include('partials/foot') %>
