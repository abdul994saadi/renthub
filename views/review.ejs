<%- include('partials/head', { title: 'Review your booking' }) %>
<div class="wrap narrow section">
  <h1>Review your booking</h1>
  <div class="card pad">
    <div class="review-car">
      <div class="thumb"><%- include('partials/car-image', { car }) %></div>
      <div>
        <h2 class="h3"><%= car.year %> <%= car.make %> <%= car.model %></h2>
        <p class="muted small"><%= car.transmission %> · <%= car.seats %> seats · <%= car.fuel %></p>
        <p class="small"><strong><%= shop.name %></strong><br><%= [shop.address, shop.city].filter(Boolean).join(', ') %></p>
      </div>
    </div>
    <table class="summary">
      <tr><td>Pick-up</td><td><%= formatDate(d.pickup) %>, <%= formatTime(d.pickupTime) %></td></tr>
      <tr><td>Return by</td><td><%= formatDate(d.ret) %>, <%= formatTime(d.pickupTime) %></td></tr>
      <tr><td>Daily rate</td><td><%= money(q.dailyPrice) %> × <%= q.days %> day<%= q.days === 1 ? '' : 's' %></td></tr>
      <tr class="total"><td>Total</td><td><%= money(q.total) %></td></tr>
      <% if (car.deposit) { %><tr><td>Refundable deposit</td><td><%= money(car.deposit) %> <span class="muted small">at pick-up</span></td></tr><% } %>
    </table>
    <h2 class="h3">Your details</h2>
    <dl class="info">
      <dt>Name</dt><dd><%= d.name %></dd>
      <dt>Email</dt><dd><%= d.email %></dd>
      <dt>Phone</dt><dd><%= d.phone %></dd>
      <% if (d.notes) { %><dt>Notes</dt><dd><%= d.notes %></dd><% } %>
    </dl>
    <p class="muted small"><% if (payAtPickup) { %>You pay <strong><%= money(q.total) %></strong> to the shop when you pick up the car. Nothing is charged now.<% } else { %>You pay <strong><%= money(q.total) %></strong> now on Amazon Payment Services' secure payment page. The car is held for you for 30 minutes while you pay.<% } %> A confirmation email will be sent to <strong><%= d.email %></strong>.<% if (car.deposit) { %> The refundable deposit is handled by the shop at pick-up.<% } %></p>

    <p class="muted small"><strong>Cancellation policy:</strong> free cancellation until <%= FREE_CANCELLATION_HOURS %> hours before pick-up. After that, cancellations are non-refundable.</p>
    <form method="post" action="/cars/<%= car.id %>/confirm" class="actions">
      <% for (const [k, v] of Object.entries({ pickup: d.pickup, pickup_time: d.pickupTime, return: d.ret, name: d.name, email: d.email, phone: d.phone, notes: d.notes, licence: 'yes' })) { %>
        <input type="hidden" name="<%= k %>" value="<%= v %>">
      <% } %>
      <a class="btn btn-ghost" href="/cars/<%= car.id %>?pickup=<%= d.pickup %>&return=<%= d.ret %>">Change</a>
      <% if (payAtPickup) { %>
      <button class="btn btn-big" type="submit">Confirm booking</button>
      <% } else { %>
      <button class="btn btn-big" type="submit"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg> Pay <%= money(q.total) %></button>
      <% } %>
    </form>
  </div>
</div>
<%- include('partials/foot') %>
