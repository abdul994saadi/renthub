<%- include('partials/head') %>
<section class="hero">
  <div class="wrap">
    <%
      // Headline phrases shown one after another; [brackets] mark the highlighted words.
      const phrases = [
        'Rent a car from trusted [local shops]',
        'Your next ride is [one tap away]',
        'Compare local shops. [Book in minutes.]',
        'Beirut to Byblos, [your way]',
        'No calls. No haggling. [Just book.]',
        'The right car at [the right price]',
        'Land in Beirut, [your car is waiting]',
        'Pick it up or [get it delivered]',
        'Mountain weekend? [Grab the keys.]',
        'Every road in Lebanon [starts here]',
      ];
      const esc = (t) => t.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
      const phraseHtml = (p) => esc(p).replace(/\[(.+?)\]/, '<span class="hl">$1</span>');
    %>
    <h1 class="hero-title" data-rotate>
      <% phrases.forEach((p, i) => { %><span class="hero-phrase<%= i ? '' : ' is-active' %>"<%- i ? ' aria-hidden="true"' : '' %>><%- phraseHtml(p) %></span><% }) %>
    </h1>
    <form class="search card" action="/cars" method="get">
      <label>City
        <select name="city">
          <option value="">Any city</option>
          <% cities.forEach(c => { %><option><%= c %></option><% }) %>
        </select>
      </label>
      <label>Pick-up<input type="date" name="pickup" min="<%= todayISO() %>"></label>
      <label>Return<input type="date" name="return" min="<%= todayISO() %>"></label>
      <label>Car type
        <select name="category">
          <option value="">Any type</option>
          <% categories.forEach(c => { %><option><%= c %></option><% }) %>
        </select>
      </label>
      <button class="btn btn-big" type="submit">Search cars</button>
    </form>
  </div>
</section>

<section class="wrap section">
  <div class="section-head">
    <h2>Newest cars</h2>
    <a href="/cars">See all cars →</a>
  </div>
  <% if (featured.length) { %>
    <div class="grid"><% featured.forEach(car => { %><%- include('partials/car-card', { car }) %><% }) %></div>
  <% } else { %>
    <div class="empty card">No cars listed yet. <a href="/shop/register">Register your shop</a> to add the first one.</div>
  <% } %>
</section>

<section class="wrap section">
  <div class="steps">
    <div class="card step"><span class="step-n">1</span><h3>Find a car</h3><p>Search by city, dates and car type across every shop.</p></div>
    <div class="card step"><span class="step-n">2</span><% if (payAtPickup) { %><h3>Book online</h3><p>Pick your dates and confirm. Pay the shop when you collect the car.</p><% } else { %><h3>Book &amp; pay online</h3><p>Pick your dates and pay securely online by card.</p><% } %></div>
    <div class="card step"><span class="step-n">3</span><h3>Get your confirmation</h3><p>We email you the booking details and shop address.</p></div>
  </div>
  <div class="card cta">
    <div><h3>Own a rental shop?</h3><p class="muted">List your cars for free and receive bookings straight to your inbox.</p></div>
    <a class="btn" href="/shop/register">List your shop</a>
  </div>
</section>
<script>
  // Rotate the headline every few seconds (not for people who prefer less motion).
  (function () {
    const root = document.querySelector('[data-rotate]');
    const items = root ? [...root.querySelectorAll('.hero-phrase')] : [];
    if (items.length < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let i = 0;
    setInterval(() => {
      if (document.hidden) return;
      items[i].classList.remove('is-active');
      i = (i + 1) % items.length;
      items[i].classList.add('is-active');
    }, 3500);
  })();
</script>
<%- include('partials/foot') %>
