<%- include('partials/head', { title: `${car.make} ${car.model}` }) %>
<div class="wrap section">
  <a href="/cars" class="back">← All cars</a>
  <div class="detail">
    <div class="detail-main">
      <%- include('partials/gallery', { car, photos }) %>
      <div class="card pad">
        <div class="title-row">
          <div>
            <h1><%= car.make %> <%= car.model %> <span class="muted"><%= car.year %></span></h1>
            <% if (rating.count) { %><a href="#reviews" class="rating-line"><%- include('partials/stars', { value: rating.average, count: rating.count }) %></a><% } %>
          </div>
          <span class="chip"><%= car.category %></span>
        </div>
        <div class="spec-grid">
          <div><span class="muted small">Gearbox</span><strong><%= car.transmission %></strong></div>
          <div><span class="muted small">Fuel</span><strong><%= car.fuel %></strong></div>
          <div><span class="muted small">Seats</span><strong><%= car.seats %></strong></div>
          <div><span class="muted small">Doors</span><strong><%= car.doors %></strong></div>
          <div><span class="muted small">Mileage</span><strong><%= car.mileage_policy %></strong></div>
          <div><span class="muted small">Deposit</span><strong><%= car.deposit ? money(car.deposit) : 'None' %></strong></div>
        </div>
        <% if (car.description) { %><p class="prewrap"><%= car.description %></p><% } %>
        <% const feats = carFeatures(car); if (feats.length) { %>
          <h2 class="h3">Features</h2>
          <ul class="features"><% feats.forEach(ft => { %><li><%= ft %></li><% }) %></ul>
        <% } %>
      </div>

      <div class="card pad">
        <h2 class="h3">Availability</h2>
        <div class="calendar" data-calendar data-today="<%= todayISO() %>" data-booked="<%= JSON.stringify(booked.map(b => [b.pickup_date, b.return_date])) %>"></div>
        <p class="muted small cal-legend"><span class="cal-key free"></span> Available <span class="cal-key booked"></span> Booked <span class="cal-key picked"></span> Your dates · Tap a day to pick dates</p>
      </div>

      <div class="card pad">
        <h2 class="h3">Rental shop</h2>
        <a href="/shops/<%= shop.id %>" class="shop-link"><strong><%= shop.name %></strong></a>
        <% if (shop.verified) { %><%- include('partials/verified') %><% } %>
        <% if (shopRating.count) { %><div class="rating-line"><%- include('partials/stars', { value: shopRating.average, count: shopRating.count }) %> <span class="muted small">for this shop</span></div><% } %>
        <% if (shop.description) { %><p class="muted"><%= shop.description %></p><% } %>
        <dl class="info">
          <dt>Address</dt><dd><%= [shop.address, shop.city].filter(Boolean).join(', ') || '—' %></dd>
          <% if (shop.phone) { %><dt>Phone</dt><dd><a href="tel:<%= shop.phone.replace(/[^\d+]/g, '') %>"><%= shop.phone %></a></dd><% } %>
          <dt>Email</dt><dd><a href="mailto:<%= shop.email %>"><%= shop.email %></a></dd>
          <% if (shop.opening_hours) { %><dt>Hours</dt><dd><%= shop.opening_hours %></dd><% } %>
        </dl>
        <% const wa = whatsappLink(shop.whatsapp || shop.phone, `Hello ${shop.name}, I'm interested in the ${car.year} ${car.make} ${car.model} on RentHub.`); if (wa) { %>
          <a class="btn btn-whatsapp" href="<%= wa %>" target="_blank" rel="noopener"><%- include('partials/wa-icon') %> Chat on WhatsApp</a>
        <% } %>
      </div>
      <div class="card pad" id="reviews">
        <h2 class="h3">Reviews</h2>
        <% if (reviews.length) { %>
          <% reviews.forEach(r => { %>
            <div class="review">
              <div><%- include('partials/stars', { value: r.rating }) %> <strong><%= r.customer_name %></strong> <span class="muted small"><%= formatDate(r.created_at.slice(0, 10)) %></span></div>
              <% if (r.comment) { %><p class="prewrap"><%= r.comment %></p><% } %>
            </div>
          <% }) %>
        <% } else { %>
          <p class="muted small">No reviews yet. Customers can review the car after their rental.</p>
        <% } %>
      </div>
    </div>

    <aside class="detail-side">
      <form class="card pad booking" method="post" action="/cars/<%= car.id %>/book" id="book">
        <div class="price big"><%= money(car.daily_price) %><small>/day</small></div>
        <% if (lbp(car.daily_price)) { %><div class="muted small lbp">≈ <%= lbp(car.daily_price) %>/day</div><% } %>
        <h2 class="h3">Book this car</h2>
        <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
        <div class="row-3 booking-dates">
          <label>Pick-up date<input type="date" name="pickup" required min="<%= todayISO() %>" value="<%= form.pickup %>" data-pickup></label>
          <label>Pick-up time
            <select name="pickup_time" required>
              <% PICKUP_TIMES.forEach(t => { %><option value="<%= t %>" <%= (form.pickupTime || '10:00') === t ? 'selected' : '' %>><%= formatTime(t) %></option><% }) %>
            </select>
          </label>
          <label>Return date<input type="date" name="return" required min="<%= todayISO() %>" value="<%= form.return %>" data-return></label>
        </div>

        <% if (pickupOptions.length > 1) { %>
          <fieldset class="choice-group">
            <legend>Pick-up</legend>
            <% pickupOptions.forEach(o => { %>
              <label class="check"><input type="radio" name="pickup_method" value="<%= o.value %>" data-fee="<%= o.fee %>" <%= (form.pickupMethod || 'shop') === o.value ? 'checked' : '' %>>
                <span><%= o.label %><% if (o.fee) { %> <span class="muted">+<%= money(o.fee) %></span><% } %></span></label>
            <% }) %>
            <label data-show-for="delivery">Delivery address<textarea name="delivery_address" rows="2" maxlength="300" placeholder="Street, building, area"><%= form.deliveryAddress || '' %></textarea>
              <% if (shop.delivery_note) { %><span class="muted small"><%= shop.delivery_note %></span><% } %></label>
            <label data-show-for="airport">Flight number (optional)<input name="flight_number" maxlength="20" placeholder="e.g. ME 202" value="<%= form.flightNumber || '' %>"></label>
          </fieldset>
        <% } %>

        <% if (extras.length) { %>
          <fieldset class="choice-group">
            <legend>Extras</legend>
            <% extras.forEach(e => { %>
              <label class="check"><input type="checkbox" name="extras" value="<%= e.id %>" data-price="<%= e.price %>" data-per="<%= e.per %>" <%= (form.extraIds || []).includes(e.id) ? 'checked' : '' %>>
                <span><%= e.name %> <span class="muted">+<%= money(e.price) %><%= e.per === 'day' ? '/day' : '' %></span></span></label>
            <% }) %>
          </fieldset>
        <% } %>

        <div class="estimate" data-estimate data-rate="<%= car.daily_price %>" data-currency="<%= CURRENCY %>" data-lbp-rate="<%= CURRENCY === 'USD' ? lbpRate() : 0 %>" hidden></div>

        <p class="muted small" data-remembered hidden>Your details from last time are filled in. <a href="#" data-forget>Not you? Clear them</a></p>
        <label>Full name<input name="name" required autocomplete="name" value="<%= form.name || '' %>"></label>
        <label>Email<input type="email" name="email" required autocomplete="email" value="<%= form.email || '' %>"></label>
        <label>Phone<input type="tel" name="phone" required autocomplete="tel" value="<%= form.phone || '' %>"></label>
        <label>Promo code (optional)<input name="promo_code" maxlength="40" autocapitalize="characters" value="<%= form.promoCode || '' %>"></label>
        <label>Notes for the shop (optional)<textarea name="notes" rows="2" maxlength="500" placeholder="e.g. arrival time, special requests"><%= form.notes || '' %></textarea></label>
        <label class="check"><input type="checkbox" name="licence" required <%= form.licence ? 'checked' : '' %>> I hold a valid driving licence</label>
        <button class="btn btn-big btn-block" type="submit">Continue to review</button>
        <p class="muted small center">Free cancellation up to <%= FREE_CANCELLATION_HOURS %> hours before pick-up.</p>
      </form>
    </aside>
  </div>

  <% if (otherCars.length) { %>
    <h2 class="section-title">More from <%= shop.name %></h2>
    <div class="grid"><% otherCars.forEach(c => { %><%- include('partials/car-card', { car: c }) %><% }) %></div>
  <% } %>
</div>
<script src="<%= asset('js/booking.js') %>"></script>
<script src="<%= asset('js/gallery.js') %>"></script>
<script src="<%= asset('js/calendar.js') %>"></script>
<%- include('partials/foot') %>
