<%- include('../partials/head', { title: 'All bookings' }) %>
<div class="wrap section">
  <%- include('../partials/admin-nav') %>
  <form class="filters card" method="get" action="/admin/bookings">
    <label class="span-2">Search<input type="search" name="q" value="<%= q %>" placeholder="Reference, customer or shop"></label>
    <label>Status
      <select name="status">
        <option value="">All</option>
        <% [['confirmed', 'Confirmed'], ['completed', 'Completed'], ['no_show', 'No-show'], ['cancelled', 'Cancelled'], ['test', 'Test / fake']].forEach(([v, l]) => { %><option value="<%= v %>" <%= status === v ? 'selected' : '' %>><%= l %></option><% }) %>
      </select>
    </label>
    <div class="filter-actions"><button class="btn" type="submit">Filter</button></div>
  </form>
  <div class="section-head">
    <p class="muted"><%= bookings.length %> booking<%= bookings.length === 1 ? '' : 's' %><%= bookings.length === 200 ? ' (latest 200; the CSV has all of them)' : '' %>. Tap a booking to manage it.</p>
    <a class="btn btn-small btn-outline" href="/admin/bookings.csv?<%= new URLSearchParams(Object.entries({ status, q }).filter(([, v]) => v)).toString() %>">Download CSV</a>
  </div>
  <% if (!bookings.length) { %><div class="empty card">No bookings found.</div><% } %>
  <%- include('bookings-table', { bookings }) %>
</div>
<%- include('../partials/foot') %>
