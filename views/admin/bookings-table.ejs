<div class="list">
  <% bookings.forEach(b => { %>
    <a class="card list-item booking-item <%= b.is_test ? 'inactive' : '' %>" href="/admin/bookings/<%= b.id %>">
      <div class="booking-main">
        <div><strong><%= b.make %> <%= b.model %></strong> · <%= b.shop_name %>
          <span class="chip chip-<%= b.status === 'confirmed' ? 'blue' : b.status === 'completed' ? 'green' : b.status === 'no_show' ? 'amber' : 'red' %>"><%= b.status === 'no_show' ? 'no-show' : b.status %></span>
          <% if (b.is_test) { %><span class="chip chip-amber">test / fake</span><% } %>
          <span class="chip <%= b.payment_status === 'paid' ? 'chip-green' : '' %>"><%= b.payment_status === 'unpaid' ? 'pay at pick-up' : b.payment_status %></span></div>
        <div class="small"><%= formatDate(b.pickup_date) %>, <%= formatTime(b.pickup_time) %> → <%= formatDate(b.return_date) %> · <strong><%= money(b.total_price) %></strong><%= b.promo_code ? ` · code ${b.promo_code}` : '' %></div>
        <% if (b.documents && b.documents.length) { %><div class="small">Documents uploaded: <%= b.documents.length %></div><% } %>
        <% if (b.admin_notes) { %><div class="small">📝 <%= b.admin_notes.slice(0, 80) %><%= b.admin_notes.length > 80 ? '…' : '' %></div><% } %>
        <% if (b.history) { %><div class="small"><%- include('../partials/customer-badge', { history: b.history }) %></div><% } %>
        <div class="small muted"><%= b.customer_name %> · <%= b.customer_email %> · <%= b.customer_phone %> · Ref <%= b.reference %> · booked <%= b.created_at.slice(0, 16) %> UTC</div>
      </div>
    </a>
  <% }) %>
</div>
