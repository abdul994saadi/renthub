<%- include('../partials/head', { title: 'Settings' }) %>
<div class="wrap section">
  <%- include('../partials/admin-nav') %>
  <form class="card pad form narrow-form" method="post" action="/admin/settings/returning" style="margin-bottom:20px">
    <h2>Returning customers</h2>
    <p class="muted small">After each rental, customers get a thank-you email asking for a review, with a "Book again" button. Add a promo code (created on the Promo codes page) to offer them a discount on their next rental. Leave empty for no discount.</p>
    <label>Promo code for returning customers (optional)<input name="returning_promo_code" maxlength="30" autocapitalize="characters" value="<%= returningCode %>" placeholder="e.g. WELCOMEBACK"></label>
    <button class="btn" type="submit">Save code</button>
  </form>
  <form class="card pad form narrow-form" method="post" action="/admin/settings/protection" style="margin-bottom:20px">
    <h2>Protection against fake bookings</h2>
    <p class="muted small">Applies while customers pay at pick-up. Online card payments do not need it.</p>
    <label class="check"><input type="checkbox" name="verify_email" <%= verify.verifyEmailRequired() ? 'checked' : '' %>> <span>Customers confirm a 6-digit code before booking<br><span class="muted small">Asked only once per phone number or email on each phone or computer.</span></span></label>
    <label>Send the code by
      <select name="verify_channel">
        <option value="whatsapp" <%= verify.codeChannel() === 'whatsapp' ? 'selected' : '' %>>WhatsApp (email if WhatsApp cannot deliver it)</option>
        <option value="email" <%= verify.codeChannel() === 'email' ? 'selected' : '' %>>Email only</option>
      </select>
    </label>
    <% if (verify.codeChannel() === 'whatsapp' && !verify.whatsappReady()) { %>
      <div class="alert alert-info small">WhatsApp is not connected yet, so codes are sent by email for now. They switch to WhatsApp automatically once <code>WHATSAPP_TOKEN</code>, <code>WHATSAPP_PHONE_NUMBER_ID</code> and <code>WHATSAPP_TEMPLATE_CODE</code> are set in Render.</div>
    <% } %>
    <label>Maximum upcoming unpaid bookings per customer (email or phone)<input name="max_open_bookings" type="number" min="0" max="50" value="<%= verify.maxOpenBookings() %>"></label>
    <p class="muted small">0 means no limit.</p>
    <button class="btn" type="submit">Save protection</button>
  </form>
  <form class="card pad form narrow-form" method="post" action="/admin/settings/whatsapp" style="margin-bottom:20px">
    <h2>WhatsApp for customer questions</h2>
    <p class="muted small">Shown as a "WhatsApp us" button at the bottom of every page. Leave empty to hide it.</p>
    <label>WhatsApp number<input name="support_whatsapp" type="tel" inputmode="tel" value="<%= supportWhatsapp() %>" placeholder="e.g. 03 123 456"></label>
    <button class="btn" type="submit">Save number</button>
  </form>
  <form class="card pad form narrow-form" method="post" action="/admin/settings/commission" style="margin-bottom:20px">
    <h2>Default commission</h2>
    <% if (commissionError) { %><div class="alert alert-error"><%= commissionError %></div><% } %>
    <p class="muted small">RentHub's share of each booking. Shops use this rate unless you give them their own rate on the <a href="/admin/shops">Shops</a> page. A new rate applies to new bookings only.</p>
    <label>Commission (%)<input name="commission_percent" inputmode="decimal" value="<%= commissionRate %>" required></label>
    <button class="btn" type="submit">Save commission</button>
  </form>
  <form class="card pad form narrow-form" method="post" action="/admin/settings">
    <h2>Lebanese pound prices</h2>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <p class="muted small">Prices are set and charged in USD. The site also shows an approximate LBP amount using this rate, rounded to the nearest 1,000 LBP. Update it when the market rate changes. Enter 0 to hide LBP prices.</p>
    <label>LBP for 1 USD<input name="lbp_rate" inputmode="numeric" value="<%= rate %>" required></label>
    <button class="btn" type="submit">Save rate</button>
  </form>
</div>
<%- include('../partials/foot') %>
