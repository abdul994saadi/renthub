<%- include('../partials/head', { title: 'Payments' }) %>
<div class="wrap section">
  <%- include('../partials/shop-nav') %>
  <p class="muted">Customers pay online when they book. RentHub collects the payments and pays out your share. Cancelling a booking refunds the customer in full.</p>
  <div class="stats">
    <div class="card stat"><span class="muted small">Paid bookings</span><strong><%= totals.count %></strong></div>
    <div class="card stat"><span class="muted small">Collected for you</span><strong><%= money(totals.gross) %></strong><span class="muted small">after refunds</span></div>
    <% if (feePercent) { %>
      <div class="card stat"><span class="muted small">RentHub fee (<%= feePercent %>%)</span><strong><%= money(fee) %></strong></div>
    <% } %>
    <div class="card stat"><span class="muted small">Your share</span><strong><%= money(totals.gross - fee) %></strong></div>
  </div>
  <h2>Recent payments</h2>
  <% if (!recent.length) { %><div class="empty card">No payments yet.</div><% } %>
  <div class="list">
    <% recent.forEach(b => { %>
      <div class="card list-item">
        <div>
          <strong><%= b.year %> <%= b.make %> <%= b.model %></strong>
          <div class="small muted"><%= b.reference %> · <%= b.customer_name %> · paid <%= b.paid_at %> UTC</div>
        </div>
        <div class="right">
          <strong><%= money(b.total_price) %></strong>
          <div><span class="chip <%= b.payment_status === 'paid' ? 'chip-green' : 'chip-red' %>"><%= b.payment_status %></span></div>
        </div>
      </div>
    <% }) %>
  </div>
</div>
<%- include('../partials/foot') %>
