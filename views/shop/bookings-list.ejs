<div class="list">
  <% bookings.forEach(b => { %>
    <div class="card list-item booking-item">
      <div class="booking-main">
        <div><strong><%= b.year %> <%= b.make %> <%= b.model %></strong> <span class="chip chip-<%= b.status === 'confirmed' ? 'blue' : b.status === 'completed' ? 'green' : 'red' %>"><%= b.status %></span>
          <span class="chip <%= b.payment_status === 'paid' ? 'chip-green' : '' %>"><%= b.payment_status === 'unpaid' ? 'pay at pick-up' : b.payment_status %></span></div>
        <div class="small"><%= formatDate(b.pickup_date) %>, <%= formatTime(b.pickup_time) %> → <%= formatDate(b.return_date) %> · <%= b.days %> day<%= b.days === 1 ? '' : 's' %> · <strong><%= money(b.total_price) %></strong></div>
        <div class="small muted"><%= b.customer_name %> · <a href="mailto:<%= b.customer_email %>"><%= b.customer_email %></a> · <a href="tel:<%= b.customer_phone.replace(/[^\d+]/g, '') %>"><%= b.customer_phone %></a></div>
        <% if (b.pickup_method === 'delivery') { %><div class="small"><strong>Deliver to:</strong> <%= b.delivery_address %></div><% } %>
        <% if (b.pickup_method === 'airport') { %><div class="small"><strong>Airport pick-up</strong><%= b.flight_number ? ` · flight ${b.flight_number}` : '' %></div><% } %>
        <% if (b.extras && b.extras.length) { %><div class="small"><strong>Extras:</strong> <%= b.extras.map(e => e.name).join(', ') %></div><% } %>
        <% if (b.promo_code) { %><div class="small muted">Promo <%= b.promo_code %>: −<%= money(b.discount) %></div><% } %>
        <% if (b.notes) { %><div class="small">“<%= b.notes %>”</div><% } %>
        <% if (b.status === 'cancelled' && b.cancelled_by) { %><div class="small muted">Cancelled by <%= b.cancelled_by === 'customer' ? 'the customer' : 'your shop' %><%= b.cancelled_at ? ` on ${b.cancelled_at.slice(0, 16)} UTC` : '' %></div><% } %>
        <div class="small muted">Ref <%= b.reference %></div>
      </div>
      <% if (b.status === 'confirmed') { %>
        <div class="booking-actions">
          <form method="post" action="/shop/bookings/<%= b.id %>/status"><input type="hidden" name="status" value="completed"><button class="btn btn-small btn-outline">Mark completed</button></form>
          <form method="post" action="/shop/bookings/<%= b.id %>/status" onsubmit="return confirm('Cancel this booking? <%= b.payment_status === 'paid' ? 'The customer will get a full refund and an email.' : 'The customer will be emailed.' %>')"><input type="hidden" name="status" value="cancelled"><button class="btn btn-small btn-danger">Cancel</button></form>
        </div>
      <% } %>
    </div>
  <% }) %>
</div>
